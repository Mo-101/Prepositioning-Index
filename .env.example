# Primary AI routing (Azure Phi-4 primary, Gemini fallback)
VITE_GEMINI_API_KEY=your-gemini-api-key

# Frontend proxy target (recommended: use the Vercel API route)
VITE_AZURE_PROXY_PATH=/api/azure-chat

# Backend-only secrets (do NOT expose in client)
AZURE_CHAT_ENDPOINT=https://<resource>.services.ai.azure.com/openai/deployments/Phi-4/chat/completions?api-version=2024-05-01-preview
AZURE_CHAT_KEY=your-azure-openai-key

# Legacy/direct client injection (only if you intentionally allow in browser)
VITE_AZURE_CHAT_ENDPOINT=$AZURE_CHAT_ENDPOINT
VITE_AZURE_CHAT_KEY=$AZURE_CHAT_KEY

# Optional legacy/alt Azure names (used by resolver fallback)
VITE_END_POINT_TARGET_URI=$VITE_AZURE_CHAT_ENDPOINT
VITE_END_POINT_KEY=$VITE_AZURE_CHAT_KEY
VITE_FOUNDRY_PROJECT_ENDPOINT=https://your-azure-openai-endpoint/api/projects/your-project/endpoints/chat/completions
VITE_AZURE_AI_SERVICES_ENDPOINT=https://your-azure-cognitiveservices-endpoint/

# Speech (if enabled)
VITE_SPEECH_TO_TEXT_ENDPOINT=https://<region>.stt.speech.microsoft.com
VITE_TEXT_TO_SPEECH_ENDPOINT=https://<region>.tts.speech.microsoft.com

# Maps (optional)
VITE_MAPBOX_TOKEN=your-mapbox-token
